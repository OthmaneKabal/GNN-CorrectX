    },
    {
      "name": "biomed_tdg_RotateEGCN",
      "enabled": true,
      "input_path": "outputs/ml_explainer/biomed_tdg__RotateEGCN__correct_prediction_all_seeds.xlsx"
    },
    {
      "name": "dbpedia_174_cg_RGCN",
      "enabled": true,
      "input_path": "outputs/ml_explainer/dbpedia_174_cg__RGCN__correct_prediction_all_seeds.xlsx"
    },
    {
      "name": "dbpedia_174_cg_RotateEGCN",
